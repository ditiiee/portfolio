<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Aditi Ankush</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">

<!--
==================================================================
  HOW TO CUSTOMIZE — tagged [EDIT]
    • Name (top-left)   • Intro sentence (doodles are inline spans)
    • Status line       • Footer links
    • Recolor via the confetti values in :root
==================================================================
-->

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

<style>
  :root {
    --cream: #FAFAF7;   /* clean near-white base */
    --ink: #1A1A1A;
    --muted: #6E6E6E;

    /* bold, solid pop palette */
    --blue:   #2B4DFF;
    --orange: #FF4A26;
    --pink:   #FF4D9E;
    --green:  #14B36A;
    --yellow: #FFC42B;

    --display: 'Inter', sans-serif;
    --body: 'Inter', sans-serif;
    --mono: 'Space Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { background: var(--cream); }
  body {
    min-height: 100vh;
    max-width: 1240px;
    margin-inline: auto;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--body);
    -webkit-font-smoothing: antialiased;
    display: flex; flex-direction: column;
    padding: clamp(1.25rem, 3.5vw, 2.4rem) clamp(1.25rem, 4vw, 3rem);
    overflow-x: hidden;
  }
  a { color: inherit; }
  :focus-visible { outline: 2.5px solid var(--blue); outline-offset: 4px; border-radius: 4px; }

  /* ---- brand wordmark ---- */
  .brand { opacity: 0; animation: rise .9s cubic-bezier(.22,1,.36,1) forwards .05s; }
  .brand-mark {
    font-family: var(--display); font-weight: 800; font-size: 1rem;
    letter-spacing: 0.01em; text-transform: uppercase;
    color: var(--ink); text-decoration: none;
  }

  /* ---- main ---- */
  .stage {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: clamp(2rem, 6vw, 4rem) 0;
  }
  .center { text-align: center; max-width: min(92vw, 900px); }

  .intro {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(2.1rem, 5.6vw, 4rem);
    line-height: 1.14; letter-spacing: -0.03em;
    text-wrap: balance;
    opacity: 0; animation: rise .9s cubic-bezier(.22,1,.36,1) forwards .2s;
  }

  /* inline doodles woven into the headline */
  .dd { display: inline-block; color: var(--c); vertical-align: -0.14em; margin: 0 .04em;
        transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
  .dd svg { height: 1.02em; width: auto; display: block; }
  .dd:hover { transform: rotate(-8deg) scale(1.12); }
  .nb { white-space: nowrap; }  /* keep each word glued to its emoji */
  .emo { font-size: .9em; }
  .dd-flower { --c: var(--orange); }
  .dd-smiley { --c: var(--green); }
  .dd-sun    { --c: var(--yellow); }
  .dd-wavy   { --c: var(--pink); vertical-align: -0.02em; }

  .helper {
    margin: clamp(1.6rem, 4vw, 2.2rem) auto 0;
    font-family: var(--mono); font-size: clamp(.78rem, 1.9vw, .88rem);
    line-height: 1.6; letter-spacing: .01em; color: var(--muted);
    text-wrap: balance;
    opacity: 0; animation: rise .9s cubic-bezier(.22,1,.36,1) forwards .45s;
  }
  .helper .pot { display: inline-block; width: 15px; height: 15px; color: var(--orange); vertical-align: -0.22em; margin-right: .2rem; }
  .helper .pot svg { width: 100%; height: 100%; display: block; }
  .helper .steam { animation: steam 2.6s ease-in-out infinite; transform-origin: center; }

  /* ---- footer ---- */
  .footer {
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    padding-top: 1.5rem;
    opacity: 0; animation: fade .7s ease forwards .7s;
  }
  .status {
    font-family: var(--mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--muted); line-height: 1.6; text-align: center;
  }
  .status .dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--green); vertical-align: middle; margin-right: .5rem;
  }
  .footer .links {
    display: flex; align-items: center; gap: 1rem;
    font-family: var(--mono); font-size: .78rem; letter-spacing: .05em; color: var(--muted);
  }
  .footer a { text-decoration: none; padding: .3rem .2rem; border-radius: 4px; transition: color .2s ease; }
  .footer a:hover, .footer a:focus-visible { color: var(--ink); }
  .footer .sep { width: 4px; height: 4px; border-radius: 50%; background: var(--muted); opacity: .6; }

  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes steam { 0%,100% { transform: translateY(0); opacity: .9; } 50% { transform: translateY(-2px); opacity: .5; } }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; }
    .brand, .intro, .helper, .footer { opacity: 1 !important; }
  }
  @media (max-width: 620px) {
    .stage { padding: clamp(1.5rem, 8vw, 3rem) 0; }
    .status { font-size: .62rem; }
  }
  @media (max-width: 400px) {
    .intro { font-size: clamp(1.65rem, 8vw, 2rem); }
    .footer { font-size: .68rem; gap: .9rem; }
  }
  @media (max-height: 560px) {
    .stage { padding: 1.25rem 0; }
    .intro { font-size: clamp(1.5rem, 4.8vw, 2.4rem); }
    .helper { margin-top: 1rem; }
  }
</style>
</head>
<body>

  <!-- ===== brand ===== -->
  <header class="brand">
    <!-- [EDIT] name -->
    <span class="brand-mark">Aditi Ankush</span>
  </header>

  <!-- ===== main ===== -->
  <main class="stage">
    <div class="center">

      <!-- [EDIT] intro — the <span class="dd ..."> pieces are the inline doodles -->
      <h1 class="intro">Hi, I'm <span class="nb">Aditi <span class="emo" aria-hidden="true">🌹</span></span> a product <span class="nb">designer <span class="emo" aria-hidden="true">🏺 📱 🎪</span>,</span> <span class="nb">sketchnoter <span class="emo" aria-hidden="true">🖍️</span></span> &amp; design <span class="nb">researcher <span class="emo" aria-hidden="true">👁️</span></span></h1>

      <!-- [EDIT] helper line -->
      <p class="helper">
        Currently working as an Experience designer at WongDoody, Bengaluru.
        <span class="pot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g class="steam"><path d="M9 3c-.6.8-.6 1.7 0 2.5"/><path d="M15 3c-.6.8-.6 1.7 0 2.5"/></g><path d="M4 10h16v4a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6z" fill="currentColor" stroke="none"/><path d="M20 12h1.5a1.5 1.5 0 0 1 0 3H20"/></svg></span>Cooking some butter chicken and this website. Brb!
      </p>

    </div>
  </main>

  <!-- ===== footer ===== -->
  <footer class="footer">
    <!-- [EDIT] links — point Resume at your PDF (a Google Drive link, or a resume.pdf you upload to this repo) -->
    <nav class="links" aria-label="Links">
      <a href="#" target="_blank" rel="noopener">Resume</a>
      <span class="sep" aria-hidden="true"></span>
      <a href="https://www.linkedin.com/in/aditiankush/" target="_blank" rel="noopener">LinkedIn</a>
      <span class="sep" aria-hidden="true"></span>
      <a href="https://www.instagram.com/ditiiee/" target="_blank" rel="noopener">@ditiiee</a>
    </nav>
  </footer>

</body>
</html>
